ROOT = Path(__file__).resolve().parents[3]
KEY = hashlib.sha256(os.fsencode(ROOT)).hexdigest()[:12]
BASE = ROOT / "target" / "verification" / KEY
SCRATCH = Path("/tmp") / ("wz-" + KEY)
EVIDENCE = BASE / "evidence"
PROFILE = "checkout-" + KEY
DISPLAY = 200 + int(KEY[:8], 16) % 30000
CONFIG = SCRATCH / "config" / "window_zones" / "config.toml"
BINARY = ROOT / "target" / "debug" / "window_zones"
STAMP = BASE / "build.json"
CHECK_EPOCH = 1704067200
EXPECTED = Path(__file__).with_name("expected.json")
FIXED_CLOCK = Path(__file__).with_name("fixed_clock.c")
OWNER = {"checkout": str(ROOT), "key": KEY, "uid": os.getuid()}
ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
VALID = '''[[bindings]]
hotkey = "Alt+Ctrl+Left"
action = { type = "move-to-zone", zone = "left-half" }

[[bindings]]
hotkey = "Alt+Ctrl+Up"
action = { type = "move-to-zone", zone = "center-third" }

[[bindings]]
hotkey = "Alt+Ctrl+Right"
action = { type = "move-to-zone", zone = "left-two-thirds" }

[[bindings]]
hotkey = "Alt+Ctrl+Down"
action = { type = "move-to-next-display" }

[[bindings]]
hotkey = "Alt+Ctrl+Shift+Right"
action = { type = "move-to-previous-display" }
'''
SEEDS = {"valid": VALID, "changed": VALID.split("\n\n")[0].replace("left-half", "right-half") + "\n",
         "invalid": VALID + "\nthis is not valid toml\n", "empty": "", "missing": None,
         "custom": VALID.split("\n\n")[0].replace("left-half", "inset") +
         "\n\n[zones.inset]\nx = 10\ny = 10\nwidth = 50\nheight = 50\n"}
ZONES = ("left-half", "right-half", "left-third", "center-third", "right-third",
         "left-two-thirds", "right-two-thirds", "maximize")


def fail(message):
    raise RuntimeError(message)


def load(path):
    try:
        value = json.loads(path.read_text())
        if not isinstance(value, dict):
            raise ValueError("expected a JSON object")
        return value
    except (ValueError, OSError) as error:
        fail(f"Cannot read {path}: {error}. Inspect it; do not borrow another checkout's state.")


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    temporary.replace(path)


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def inputs():
    files = [ROOT / "Cargo.toml", ROOT / "Cargo.lock", Path(__file__).resolve(), EXPECTED, FIXED_CLOCK]
    for directory in ("src", "gnome-extension", "kwin-script", "scripts", ".cargo"):
        files.extend(p for p in (ROOT / directory).rglob("*") if p.is_file())
    hashed = hashlib.sha256()
    for path in sorted(files):
        hashed.update(os.fsencode(path.relative_to(ROOT)))
        hashed.update(path.read_bytes())
    toolchain = subprocess.check_output(["rustc", "--version"], text=True).strip()
    build_env = {k: v for k, v in os.environ.items() if k.startswith(("CARGO_", "RUST"))}
    build_env["CARGO_TARGET_DIR"] = str(ROOT / "target")
    hashed.update(json.dumps([toolchain, build_env], sort_keys=True).encode())
    return hashed.hexdigest(), toolchain


def build_status():
    if not STAMP.exists():
        return "missing: run launch"
    stamp = load(STAMP)
    current, _ = inputs()
    if stamp.get("inputs") != current:
        return "stale: source, verifier, toolchain or build environment changed; run launch"
    for name, expected in stamp["binaries"].items():
        path = BINARY.with_name(name)
        if not path.is_file() or digest(path) != expected:
            return f"stale: {path} differs from the recorded build; run launch"
    return "current"


def state(required=True):
    if SCRATCH.is_symlink() or (SCRATCH.exists() and
            (not SCRATCH.is_dir() or SCRATCH.stat().st_uid != os.getuid() or SCRATCH.stat().st_mode & 0o077)):
        fail(f"Unsafe profile at {SCRATCH}; require a private owned directory, not a symlink. Inspect it before launch or cleanup.")
    if not (SCRATCH / "owner.json").exists():
        if required:
            fail("No launched verifier profile. Run launch first; doctor explains the expected paths.")
        return None
    value = load(SCRATCH / "owner.json")
    if any(value.get(k) != v for k, v in OWNER.items()):
        fail(f"Foreign profile at {SCRATCH}; refusing to attach or clean it. Use this checkout's launch.")
    destination = Path(value["evidence"])
    if destination.parent != EVIDENCE or destination.is_symlink():
        fail("Evidence path is outside this checkout's evidence directory. Inspect owner.json.")
    return value


def process(pid):
    try:
        proc = Path("/proc") / str(pid)
        fields = (proc / "stat").read_text().rsplit(")", 1)[1].split()
        environment = (proc / "environ").read_bytes().split(b"\0")
        return {"pid": pid, "start": fields[19], "state": fields[0],
                "cwd": str((proc / "cwd").resolve(strict=True)),
                "command": (proc / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip(),
                "checkout_marker": next((v.decode(errors="replace").split("=", 1)[1]
                                         for v in environment if v.startswith(b"WINDOW_ZONES_VERIFY_CHECKOUT=")), None),
                "runtime_marker": next((v.decode(errors="replace").split("=", 1)[1]
                                        for v in environment if v.startswith(b"XDG_RUNTIME_DIR=")), None)}
    except (OSError, IndexError):
        return None


def active():
    path = SCRATCH / "active.json"
    if not path.exists():
        return None
    saved = load(path)
    observed = process(saved["pid"])
    if observed and observed["state"] != "Z" and observed["start"] == saved["start"]:
        if observed["cwd"] != str(ROOT) or observed["checkout_marker"] != str(ROOT):
            fail(f"PID {saved['pid']} belongs to a foreign instance. Refusing to attach; inspect /proc/{saved['pid']}.")
        return observed
    return None


def runtime_processes():
    result = []
    for directory in Path("/proc").iterdir():
        if not directory.name.isdigit():
            continue
        try:
            if directory.stat().st_uid != os.getuid():
                continue
        except OSError:
            continue
        observed = process(int(directory.name))
        if (observed and observed["state"] != "Z" and observed["checkout_marker"] == str(ROOT)
                and observed["runtime_marker"] == str(SCRATCH / "runtime") and observed["pid"] != os.getpid()):
            result.append(observed)
    return result


def display_owner():
    socket = Path(f"/tmp/.X11-unix/X{DISPLAY}")
    lock = Path(f"/tmp/.X{DISPLAY}-lock")
    owner = None
    if lock.exists():
        try:
            owner = process(int(lock.read_text().strip()))
        except ValueError:
            pass
    return {"display": f":{DISPLAY}", "socket": str(socket), "present": socket.exists() or lock.exists(),
            "owner": owner, "ours": bool(owner and owner["checkout_marker"] == str(ROOT)
                                          and owner["cwd"] == str(ROOT))}


def env():
    result = dict(os.environ)
    for name in ("DISPLAY", "WAYLAND_DISPLAY", "WAYLAND_SOCKET", "SWAYSOCK", "HYPRLAND_INSTANCE_SIGNATURE",
                 "DBUS_SESSION_BUS_ADDRESS", "XAUTHORITY", "DCONF_PROFILE"):
        result.pop(name, None)
    result["CARGO_HOME"] = os.environ.get("CARGO_HOME", str(Path.home() / ".cargo"))
    result["RUSTUP_HOME"] = os.environ.get("RUSTUP_HOME", str(Path.home() / ".rustup"))
    result.update({"HOME": str(SCRATCH / "home"), "XDG_CONFIG_HOME": str(SCRATCH / "config"),
                   "XDG_DATA_HOME": str(SCRATCH / "data"), "XDG_STATE_HOME": str(SCRATCH / "state"),
                   "XDG_CACHE_HOME": str(SCRATCH / "cache"), "XDG_RUNTIME_DIR": str(SCRATCH / "runtime"),
                   "WINDOW_ZONES_BINARY": str(BINARY), "CARGO_TARGET_DIR": str(ROOT / "target"),
                   "WINDOW_ZONES_VERIFY_CHECKOUT": str(ROOT), "XDG_SESSION_TYPE": "x11"})
    return result


def artifact():
    return Path(state()["evidence"])


def event(kind, **values):
    with (artifact() / "actions.jsonl").open("a") as output:
        output.write(json.dumps({"time": datetime.datetime.now(datetime.timezone.utc).isoformat(),
                                 "kind": kind, **values}) + "\n")


def snapshot():
    return {str(p.relative_to(SCRATCH)): digest(p) for p in SCRATCH.rglob("*")
            if p.is_file() and p.name not in ("active.json", "owner.json")}


@contextlib.contextmanager
def lock():
    BASE.mkdir(parents=True, exist_ok=True)
    with (BASE / "control.lock").open("a+") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fail("This checkout already has an active verifier command. Let it finish; run doctor, not a second drive.")
        yield


def require_ready():
    state()
    status = build_status()
    if status != "current":
        fail(f"Build {status}. Stale builds are not evidence.")
    if active():
        fail("A verifier process is already running. Use doctor/logs; cleanup only if this is your abandoned run.")
    owner = display_owner()
    if owner["present"] and not owner["ours"]:
        fail(f"Display {owner['display']} is occupied by {owner['owner'] or 'an unknown owner'}. "
             "Refusing to attach. Stop it from its owning checkout, then retry.")


def track(child):
    details = process(child.pid)
    if not details:
        fail(f"Process {child.pid} exited before ownership could be recorded. Inspect logs, then cleanup.")
    save(SCRATCH / "active.json", details)


def stop(child):
    if child.poll() is None:
        os.killpg(child.pid, signal.SIGTERM)
        try:
            child.wait(timeout=15)
        except subprocess.TimeoutExpired:
            os.killpg(child.pid, signal.SIGKILL)
            child.wait()
    (SCRATCH / "active.json").unlink(missing_ok=True)


def run(command, label, timeout=60, environment=None, timings=None):
    folder = artifact()
    stdout, stderr = folder / f"{label}.stdout", folder / f"{label}.stderr"
    event("exec", command=shlex.join(command), stdout=str(stdout), stderr=str(stderr))
    with stdout.open("wb") as out, stderr.open("wb") as err:
        started = time.perf_counter_ns()
        child = subprocess.Popen(command, cwd=ROOT, env=environment or env(), stdout=out, stderr=err,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
        track(child)
        try:
            if timings is None:
                rc = child.wait(timeout=timeout)
            else:
                finished = os.pidfd_open(child.pid)
                try:
                    if not select.select([finished], [], [], timeout)[0]:
                        raise subprocess.TimeoutExpired(command, timeout)
                    rc = child.wait()
                finally:
                    os.close(finished)
            if timings is not None:
                timings.append(time.perf_counter_ns() - started)
        finally:
            stop(child)
    text = stdout.read_text(errors="replace") + stderr.read_text(errors="replace")
    event("exit", label=label, code=rc)
    print(text, end="")
    return rc, text


def set_config(seed, zone=None):
    previous = CONFIG.read_text() if CONFIG.exists() else None
    text = SEEDS[seed]
    if zone:
        if seed != "valid":
            fail("--zone requires the valid seed. Use drive config valid --zone NAME.")
        text = text.replace('zone = "left-half"', f'zone = "{zone}"', 1)
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    if text is None:
        CONFIG.unlink(missing_ok=True)
    else:
        CONFIG.write_text(text)
    event("config-edit", seed=seed, path=str(CONFIG), before=previous, after=text)


def app_args(options, arguments):
    flags = ["--dry-run"] if options.backend_flag == "alias" else ["--backend", "dry-run"]
    if not options.discovery:
        flags += ["--config", str(CONFIG)]
    return [str(ROOT / "scripts" / "run.sh"), *flags, *arguments]


class Terminal:
    def __init__(self, command, label):
        self.master, slave = pty.openpty()
        self.raw = (artifact() / f"{label}.ansi").open("wb")
        self.text = ""
        event("pty-launch", command=shlex.join(command), transcript=self.raw.name)
        self.child = subprocess.Popen(command, cwd=ROOT, env=env(), stdin=slave, stdout=slave, stderr=slave,
                                      start_new_session=True)
        os.close(slave)
        track(self.child)

    def read(self, timeout):
        if select.select([self.master], [], [], timeout)[0]:
            try:
                data = os.read(self.master, 65536)
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
                data = b""
            self.raw.write(data)
            self.raw.flush()
            self.text += ANSI.sub("", data.decode(errors="replace")).replace("\r", "")

    def wait(self, expected, offset=0, timeout=15):
        deadline = time.monotonic() + timeout
        while expected not in self.text[offset:]:
            if time.monotonic() >= deadline:
                fail(f"Timed out waiting for {expected!r}. Inspect {self.raw.name}, then run doctor and cleanup.")
            self.read(min(0.1, max(0, deadline - time.monotonic())))
            if self.child.poll() is not None and expected not in self.text[offset:]:
                fail(f"App exited {self.child.returncode} before {expected!r}. Inspect {self.raw.name}.")
        return self.text[offset:]

    def send(self, command, expected):
        self.read(0)
        offset = len(self.text)
        event("terminal-input", command=command, expect=expected)
        os.write(self.master, (command + "\n").encode())
        observed = self.wait(expected, offset)
        event("terminal-result", command=command, observed=observed)
        return observed

    def status(self, expected, mode):
        prompt = "window-zones tui> " if mode == "tui" else "window-zones> "
        deadline = time.monotonic() + 15
        while time.monotonic() < deadline:
            observed = self.send("status", prompt)
            if expected in observed:
                return observed
            self.read(0.1)  # Poll output while waiting for the observable, debounced config state.
        fail(f"Status never reached {expected!r}. Inspect {self.raw.name}; do not replace this check with a sleep.")

    def close(self):
        stop(self.child)
        os.close(self.master)
        self.raw.close()
        Path(self.raw.name).with_suffix(".txt").write_text(self.text)


def session(options):
    terminal = Terminal(app_args(options, [options.mode]), f"session-{time.time_ns()}")
    prompt = "window-zones tui> " if options.mode == "tui" else "window-zones> "
    try:
        terminal.wait(prompt)
        if options.command:
            if len(options.command) != len(options.expect):
                fail("Pair each --command with one --expect observable result; see drive session --help.")
            for command, expected in zip(options.command, options.expect):
                if command.lower() in ("quit", "q", "exit"):
                    fail("Use --quit for exit paths; --command must leave the app running.")
                terminal.send(command, expected)
        else:
            terminal.send("status", prompt)
            if options.mode == "tui":
                terminal.send("refresh", prompt)
            terminal.send("dispatch Alt+Ctrl+Left", "Last action: alt+ctrl+left" if options.mode == "tui"
                          else "Dispatch state: Succeeded")
            if options.journey in ("reload", "watcher"):
                for seed, expected in (("changed", "right-half" if options.mode == "tui" else "binding count: 1"),
                                       ("invalid", "(Error" if options.mode == "tui" else "config state: Error"),
                                       ("empty", "Bindings:\n  <none>" if options.mode == "tui" else "binding count: 0"),
                                       ("missing", "(Missing)" if options.mode == "tui" else "config state: Missing"),
                                       ("valid", "left-half" if options.mode == "tui" else "binding count: 5")):
                    set_config(seed)
                    if options.journey == "reload":
                        terminal.send("reload", prompt)
                    observed = terminal.status(expected, options.mode)
                    if seed == "invalid":
                        retained = "right-half" if options.mode == "tui" else "binding count: 1"
                        if retained not in observed:
                            fail("Invalid config did not retain the last valid binding. Keep evidence and report this failure.")
                        terminal.send("dispatch Alt+Ctrl+Left", "Last action: alt+ctrl+left" if options.mode == "tui"
                                      else "Dispatch state: Succeeded")
            terminal.send("reload", prompt)
            terminal.send("restart", prompt)
            terminal.status("Loaded", options.mode)
        if options.quit == "eof":
            event("terminal-input", command="<Ctrl-D>", expect="Session closed.")
            offset = len(terminal.text)
            os.write(terminal.master, b"\x04")
            terminal.wait("Session closed.", offset)
        else:
            terminal.send(options.quit, "Session closed.")
        rc = terminal.child.wait(timeout=10)
        event("pty-exit", code=rc)
        if rc:
            fail(f"Session exited {rc}. Inspect the transcript.")
    finally:
        terminal.close()


def doctor():
    profile = state(required=False)
    report = {**OWNER, "profile": PROFILE, "data_directory": str(SCRATCH / "data"),
              "config": str(CONFIG), "tcp_ports": [], "port_owner": "N/A: no TCP service; Xvfb uses -nolisten tcp",
              "x11": display_owner(), "active_process": active() if profile else None,
              "binary": str(BINARY), "build": build_status(), "launched": bool(profile),
              "evidence": profile["evidence"] if profile else None,
              "lifecycle": "build once; every CLI/TUI drive owns a new short-lived process/PTY"}
    print(json.dumps(report, indent=2))
    owner = report["x11"]
    return 0 if profile and report["build"] == "current" and (not owner["present"] or owner["ours"]) else 1


def launch(options):
    if SCRATCH.exists():
        state()
        fail("A profile already exists. Run cleanup --dry-run, then cleanup before launch; evidence is retained.")
    owner = display_owner()
    if owner["present"]:
        fail(f"Derived display {owner['display']} is occupied: {owner['owner']}. Do not attach; release it from its owner.")
    folder = EVIDENCE / (datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ-") + uuid.uuid4().hex[:8])
    folder.mkdir(parents=True)
    SCRATCH.mkdir(mode=0o700)
    for name in ("home", "config/window_zones", "data", "state", "cache", "runtime"):
        (SCRATCH / name).mkdir(parents=True, mode=0o700)
    save(SCRATCH / "owner.json", {**OWNER, "evidence": str(folder)})
    try:
        before, toolchain = inputs()
        # Build with the user's real Cargo home/toolchain; app drives use the disposable HOME.
        build_env = dict(os.environ, CARGO_TARGET_DIR=str(ROOT / "target"), WINDOW_ZONES_VERIFY_CHECKOUT=str(ROOT))
        rc, _ = run(["cargo", "build", "--locked", "--bins"], "build", timeout=300, environment=build_env)
        if rc:
            fail(f"Build failed. Inspect {folder / 'build.stderr'}; fix the checkout before relaunching.")
        after, _ = inputs()
        if before != after:
            fail("Build inputs changed during compilation. Run cleanup, then launch again.")
        names = ("window_zones", "window_zones_kwin")
        save(STAMP, {**OWNER, "inputs": after, "toolchain": toolchain, "cargo_profile": "debug",
                     "binaries": {name: digest(BINARY.with_name(name)) for name in names}})
        set_config("valid")
        rc, text = run(app_args(options, ["status"]), "ready")
        if rc or "binding count: 5" not in text or "config state: Loaded" not in text:
            fail("Ready probe did not load all five seeded bindings. Inspect ready.stdout/stderr.")
        save(folder / "launch.json", {**OWNER, "build": load(STAMP), "profile": PROFILE,
                                      "config": str(CONFIG), "display": f":{DISPLAY}"})
        print(f"READY {PROFILE}\nEvidence: {folder}")
    except BaseException:
        cleanup(False)
        raise


def cleanup(dry_run):
    profile = state(required=False)
    if not profile:
        print(f"No profile to remove. Evidence retained: {EVIDENCE}")
        return
    running = active()
    runtime = runtime_processes()
    mounts = [path for path in (SCRATCH / "runtime/doc", SCRATCH / "runtime/gvfs") if os.path.ismount(path)]
    plan = {"terminate": running, "terminate_runtime": runtime, "unmount": list(map(str, mounts)),
            "remove": str(SCRATCH), "retain_evidence": profile["evidence"]}
    print(json.dumps(plan, indent=2))
    if dry_run:
        return
    if running:
        os.kill(running["pid"], signal.SIGTERM)
        deadline = time.monotonic() + 20
        while active() and time.monotonic() < deadline:
            select.select([], [], [], 0.1)
        if active():
            fail(f"PID {running['pid']} did not stop. Inspect it before retrying cleanup; evidence is retained.")
    for observed in runtime:
        current = process(observed["pid"])
        if current and current["start"] == observed["start"]:
            with contextlib.suppress(ProcessLookupError):
                os.kill(observed["pid"], signal.SIGTERM)
    deadline = time.monotonic() + 5
    while runtime_processes() and time.monotonic() < deadline:
        select.select([], [], [], 0.1)
    for observed in runtime_processes():
        with contextlib.suppress(ProcessLookupError):
            os.kill(observed["pid"], signal.SIGKILL)
    for path in mounts:
        if os.path.ismount(path):
            unmount = subprocess.run(["fusermount3", "-u", str(path)], capture_output=True, text=True)
            if unmount.returncode and os.path.ismount(path):
                fail(f"Cannot unmount owned scratch {path}: {unmount.stderr.strip()}. Inspect cleanup --dry-run holders, then retry cleanup.")
    event("cleanup", removed=str(SCRATCH))
    # Keep ownership recoverable if a mounted/read-only child cannot be removed.
    for child in SCRATCH.iterdir():
        if child.name != "owner.json":
            if child.is_dir() and not child.is_symlink():
                shutil.rmtree(child)
            else:
                child.unlink()
    (SCRATCH / "owner.json").unlink()
    try:
        SCRATCH.rmdir()
    except OSError:
        save(SCRATCH / "owner.json", profile)
        raise
    if not Path(profile["evidence"]).is_dir():
        fail("Evidence disappeared during cleanup. This run is invalid.")


def smoke(options):
    required = {"x11": ["Xvfb", "openbox", "xdotool", "xrandr", "xprop", "gnome-text-editor", "ffmpeg", "dbus-run-session"],
                "gnome": ["gnome-shell", "gjs", "dbus-run-session", "gnome-text-editor"],
                "kde-live": ["kwin_wayland", "kpackagetool6", "kwriteconfig6", "busctl", "gjs", "xdotool",
                             "xprop", "dbus-run-session", "python", "setsid", "gnome-text-editor"]}
    missing = [tool for tool in required[options.gate] if not shutil.which(tool)]
    if missing:
        fail(f"Missing {', '.join(missing)}. Install the prerequisites in docs/runbooks/testing.md; do not substitute a fake compositor.")
    environment = env()
    label = options.gate + "-" + str(time.time_ns())
    native_state = SCRATCH / label
    native_proof = artifact() / label
    environment.update(WINDOW_ZONES_SMOKE_ROOT=str(native_state), WINDOW_ZONES_SMOKE_DISPLAY=str(DISPLAY),
                       CARGO_NET_OFFLINE="true")
    command = [str(ROOT / "scripts/smoke.sh"), "--keep-logs", options.gate]
    if options.gate == "x11":
        command = ["dbus-run-session", "--", *command]
    try:
        rc, text = run(command, "smoke-" + label, timeout=600, environment=environment)
    finally:
        # Preserve proof files, not compositor sockets, profiles or application data.
        for path in native_state.rglob("*"):
            relative = path.relative_to(native_state)
            if path.is_file() and not any(part in {"home", "config", "data", "runtime", "cache", "state"}
                                          for part in relative.parts[:-1]):
                destination = native_proof / relative
                destination.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(path, destination)
        event("native-evidence", path=str(native_proof))
    if rc or "failures: 0" not in text:
        fail(f"{options.gate} smoke failed. Keep its assertions/screenshots; fix the reported precondition or app behavior before retrying.")
    return native_proof


def differences(expected, actual, path="$"):
    if type(expected) is type(actual) and isinstance(expected, dict):
        result = []
        for key in sorted(expected.keys() | actual.keys()):
            if key not in expected or key not in actual:
                result.append({"path": f"{path}.{key}", "expected": expected.get(key, {"missing": True}),
                               "actual": actual.get(key, {"missing": True})})
            else:
                result.extend(differences(expected[key], actual[key], f"{path}.{key}"))
        return result
    if type(expected) is type(actual) and isinstance(expected, list):
        result = []
        for index in range(max(len(expected), len(actual))):
            if index >= len(expected) or index >= len(actual):
                result.append({"path": f"{path}[{index}]", "expected": expected[index] if index < len(expected) else {"missing": True},
                               "actual": actual[index] if index < len(actual) else {"missing": True}})
            else:
                result.extend(differences(expected[index], actual[index], f"{path}[{index}]"))
        return result
    return [] if type(expected) is type(actual) and expected == actual else [
        {"path": path, "expected": expected, "actual": actual}
    ]


def dispatch_observation(code, text, config=CONFIG):
    def field(pattern):
        match = re.search(pattern, text, re.MULTILINE)
        return match.group(1) if match else None
    count = field(r"^  binding count: (\d+)$")
    geometry = re.search(r"^  last move: x=(-?\d+) y=(-?\d+) w=(\d+) h=(\d+)$", text, re.MULTILINE)
    config_path = field(r"^  config path: (.+)$")
    return {"exit_code": code, "backend": field(r"^Using runtime window backend: (.+)$"),
            "config_path": "$CONFIG" if config_path == str(config) else config_path,
            "config_state": field(r"^  config state: (\w+)"), "bindings": int(count) if count else None,
            "dispatch": field(r"^Dispatch state: (\w+)"),
            "error": field(r"^Dispatch state: Error\((\w+)"),
            "geometry": list(map(int, geometry.groups())) if geometry else None}


def check_seed(seed, zone=None):
    set_config(seed, zone)
    if CONFIG.exists():
        os.utime(CONFIG, (CHECK_EPOCH, CHECK_EPOCH))


def clock_environment(prefix, golden):
    library, probe = SCRATCH / "fixed-clock.so", SCRATCH / "clock-probe"
    for flags, destination, name in ((["-shared", "-fPIC"], library, "clock-build"),
                                     (["-DCLOCK_PROBE"], probe, "probe-build")):
        code, _ = run(["cc", "-O2", "-Wall", "-Wextra", "-Werror", *flags, str(FIXED_CLOCK), "-o", str(destination)],
                      f"{prefix}/{name}")
        if code:
            fail("Clock helper did not compile. Install a working C compiler and inspect clock-build/probe-build.stderr.")
    fixed = {"LD_PRELOAD": str(library), "TZ": "UTC", "LC_ALL": "C.UTF-8", "PYTHONHASHSEED": "0",
             "SOURCE_DATE_EPOCH": str(CHECK_EPOCH)}
    code, text = run([str(probe)], f"{prefix}/clock-probe", environment={**env(), **fixed})
    observed = json.loads(text) if code == 0 else {"exit_code": code}
    delta = differences(golden["clock"], observed, "$.clock")
    if delta:
        fail(f"Fixed clock probe mismatched: {json.dumps(delta)}. Inspect clock-probe.stdout; do not run unfrozen checks.")
    return fixed, observed


def check_behaviors(prefix):
    result = {}
    cases = [(zone, "valid", zone, "Alt+Ctrl+Left") for zone in ZONES]
    cases += [("custom", "custom", None, "Alt+Ctrl+Left"), ("next-display", "valid", None, "Alt+Ctrl+Down"),
              ("previous-display", "valid", None, "Alt+Ctrl+Shift+Right"), ("unbound", "valid", None, "Alt+Ctrl+F12")]
    cases += [(seed, seed, None, "Alt+Ctrl+Left") for seed in ("empty", "missing", "invalid")]
    for flag in ("backend", "alias"):
        for discovery in (False, True):
            variant = f"{flag}-{'discovery' if discovery else 'explicit'}"
            result[variant] = {}
            options = argparse.Namespace(backend_flag=flag, discovery=discovery)
            for name, seed, zone, hotkey in cases:
                check_seed(seed, zone)
                code, text = run(app_args(options, ["dispatch", hotkey]), f"{prefix}/{variant}-{name}")
                result[variant][name] = dispatch_observation(code, text)
    check_seed("valid")
    return result


def check_e2e(prefix):
    native = smoke(argparse.Namespace(gate="x11"))
    assertions = (native / "assertions.log").read_text()
    native_run = (native / "x11/run.log").read_text()
    tui = ANSI.sub("", (native / "x11-x11-tui.log").read_text())
    geometry = {}
    for match in re.finditer(r"^PASS ([^:\n]+): expected '[^']*' observed '(-?\d+),(-?\d+),(\d+),(\d+)'", assertions, re.MULTILINE):
        name = match.group(1)
        if name in ("x11-left-half", "x11-center-third", "x11-left-two-thirds", "x11-next-display",
                    "x11-previous-display", "X11 real hotkey moves window"):
            geometry[name] = list(map(int, match.groups()[1:]))
    summary = re.search(r"Smoke assertions: \d+; failures: (\d+)", assertions)
    after_error = native_run.partition("Config reload error:")[2]
    retained = re.search(r"binding count: (\d+)", after_error)
    action = re.findall(r"last action: (alt\+ctrl\+\w+)", native_run)
    tui_action = re.findall(r"Last action: (alt\+ctrl\+\w+)", tui)
    captures = sorted(p.name for p in native.glob("*.png")
                      if p.name in {"x11-x11-left-half.png", "x11-x11-center-third.png", "x11-x11-left-two-thirds.png",
                                    "x11-x11-next-display.png", "x11-x11-previous-display.png", "x11-x11-real-hotkey.png"}
                      and p.read_bytes()[:8] == b"\x89PNG\r\n\x1a\n")
    # A new user-facing process must read the file the native runtime left on disk.
    persisted = native / "x11/config.toml"
    code, text = run([str(ROOT / "scripts/run.sh"), "--backend", "dry-run", "--config", str(persisted),
                      "dispatch", "Alt+Ctrl+Left"], f"{prefix}/persisted-dispatch")
    before_cancel = CONFIG.read_bytes()
    session(argparse.Namespace(mode="tui", backend_flag="backend", discovery=False, journey="lifecycle",
                               command=["status"], expect=["Config:"], quit="eof"))
    return {"failures": int(summary.group(1)) if summary else None, "geometry": geometry, "captured_png": captures,
            "native_backend": "x11" if "Window backend: x11" in native_run else None,
            "hotkey_action": action[-1] if action else None, "retained_binding_count": int(retained.group(1)) if retained else None,
            "config_recovered": "Config state: Loaded" in after_error,
            "tui_action": tui_action[-1] if tui_action else None, "run_closed": "Session closed." in native_run,
            "tui_closed": "Session closed." in tui, "cancel_config_unchanged": CONFIG.read_bytes() == before_cancel,
            "persisted_dispatch": dispatch_observation(code, text, persisted)}


def measurement_summary(samples):
    return {"runs": len(samples), "median_ms": statistics.median(samples) / 1_000_000,
            "min_ms": min(samples) / 1_000_000, "max_ms": max(samples) / 1_000_000,
            "spread_ms": (max(samples) - min(samples)) / 1_000_000}


def check_performance(options, prefix, golden):
    if options.runs < 5:
        fail("--runs must be at least 5 per side. Use --runs 5 or more.")
    if not math.isfinite(options.max_regression_percent) or options.max_regression_percent < 0:
        fail("--max-regression-percent must be a finite nonnegative budget, such as 25.")
    code, text = run(["git", "rev-parse", "--verify", "--end-of-options", options.baseline_ref + "^{commit}"],
                     f"{prefix}/baseline-ref")
    commit = text.strip()
    if code or not re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", commit):
        fail(f"Cannot resolve baseline ref {options.baseline_ref!r}. Supply an existing local commit, branch or tag; no fetch is performed.")
    source = SCRATCH / ("baseline-" + uuid.uuid4().hex[:8])
    source.mkdir()
    archive_path = source / "source.tar"
    code, _ = run(["git", "archive", "--format=tar", "--output", str(archive_path), commit], f"{prefix}/baseline-archive")
    if code:
        fail("Baseline archive failed. Inspect baseline-archive.stderr; the working tree and git refs were not changed.")
    with tarfile.open(archive_path) as archive:
        archive.extractall(source, filter="data")
    archive_path.unlink()
    target = source / "target"
    # Compilation is outside the sample window and must use the real toolchain/cache clock.
    build_env = dict(os.environ, CARGO_TARGET_DIR=str(target), CARGO_NET_OFFLINE="true",
                     WINDOW_ZONES_VERIFY_CHECKOUT=str(ROOT))
    build_env.pop("LD_PRELOAD", None)
    code, _ = run(["cargo", "build", "--locked", "--manifest-path", str(source / "Cargo.toml"), "--bin", "window_zones"],
                  f"{prefix}/baseline-build", timeout=300, environment=build_env)
    if code:
        fail("Baseline build failed. Inspect baseline-build.stderr; make its locked dependencies available locally, then relaunch. No sample was counted.")
    baseline_binary = target / "debug/window_zones"
    baseline_hash = digest(baseline_binary)
    commands = {
        "baseline": ([str(source / "scripts/run.sh"), "--backend", "dry-run", "--config", str(CONFIG),
                      "dispatch", "Alt+Ctrl+Left"], {**env(), "WINDOW_ZONES_BINARY": str(baseline_binary)}),
        "candidate": (app_args(argparse.Namespace(backend_flag="backend", discovery=False), ["dispatch", "Alt+Ctrl+Left"]), env()),
    }
    samples = {"baseline": [], "candidate": []}
    observations, delta = [], []
    for round_number in range(options.runs + 1):
        for side in ("baseline", "candidate"):
            label = f"{prefix}/{side}-{'warmup' if round_number == 0 else round_number}"
            elapsed = []
            command, environment = commands[side]
            code, text = run(command, label, environment=environment, timings=elapsed)
            observed = dispatch_observation(code, text)
            trial_delta = differences(golden["dispatch"], observed, f"$.{side}[{round_number}].dispatch")
            delta.extend(trial_delta)
            observations.append({"side": side, "round": round_number, "warmup": round_number == 0,
                                 "elapsed_ns": elapsed[0], "work_confirmed": not trial_delta,
                                 "result": observed, "stdout": str(artifact() / (label + ".stdout")),
                                 "stderr": str(artifact() / (label + ".stderr"))})
            if round_number:
                samples[side].append(elapsed[0])
    summary = {side: measurement_summary(values) for side, values in samples.items()}
    baseline_median = statistics.median(samples["baseline"])
    candidate_median = statistics.median(samples["candidate"])
    maximum = baseline_median * (1 + options.max_regression_percent / 100)
    if candidate_median > maximum:
        delta.append({"path": "$.candidate.median_ms", "expected": {"maximum": maximum / 1_000_000},
                      "actual": candidate_median / 1_000_000})
    if digest(baseline_binary) != baseline_hash:
        delta.append({"path": "$.baseline.binary_sha256", "expected": baseline_hash, "actual": digest(baseline_binary)})
    return {"dispatch": golden["dispatch"], "runs_per_side": options.runs,
            "max_regression_percent": options.max_regression_percent}, {
                "baseline_ref": options.baseline_ref, "baseline_commit": commit, "baseline_binary_sha256": baseline_hash,
                "metric": "debug process startup + dispatch through each revision's scripts/run.sh; pidfd completion, capture and ownership overhead included",
                "excluded": ["compilation", "one confirmed warmup per side", "result parsing and comparison"],
                "summary": summary, "regression_percent": (candidate_median / baseline_median - 1) * 100,
                "samples": observations, "work_confirmed": all(trial["work_confirmed"] for trial in observations),
                "fixed_input_unchanged": CONFIG.read_text() == VALID and CONFIG.stat().st_mtime_ns == CHECK_EPOCH * 1_000_000_000,
            }, delta


def check_command(options):
    label = f"{options.scenario}-{uuid.uuid4().hex[:8]}"
    folder = BASE / "check-errors" / label
    report = {"scenario": options.scenario, "status": "error", "difference": [],
              "fixture": {"seed": 0, "wall_time_epoch": CHECK_EPOCH, "timezone": "UTC",
                          "monotonic_clock": "real for deadlines and measurements; not a golden value"}}
    owned = False
    guard = contextlib.ExitStack()
    original_env = dict(os.environ)
    try:
        if options.dry_run:
            print(json.dumps({**report, "status": "planned", "evidence_path": None, "options": vars(options)}))
            return 0
        guard.enter_context(lock())
        with open(os.devnull, "w") as quiet, contextlib.redirect_stdout(quiet):
            require_ready()
            owned = True
            folder = artifact() / "checks" / label
            folder.mkdir(parents=True)
            prefix = str(folder.relative_to(artifact()))
            golden_path = Path(options.expected_file).resolve()
            golden = load(golden_path)
            report.update(build=load(STAMP), expected_file=str(golden_path), expected_sha256=digest(golden_path))
            fixed, observed_clock = clock_environment(prefix, golden)
            report["clock_probe"] = observed_clock
            os.environ.update(fixed)
            check_seed("valid")
            if options.scenario == "behaviors":
                observed = check_behaviors(prefix)
                expected = {variant: {name: {**golden["dispatch"], **overrides}
                                      for name, overrides in golden["behaviors"].items()}
                            for variant in ("backend-explicit", "backend-discovery", "alias-explicit", "alias-discovery")}
                delta = differences(expected, observed)
            elif options.scenario == "e2e":
                expected, observed = golden["e2e"], check_e2e(prefix)
                delta = differences(expected, observed)
            else:
                expected, observed, delta = check_performance(options, prefix, golden)
                if not observed["work_confirmed"] or not observed["fixed_input_unchanged"]:
                    delta.append({"path": "$.confirmed_fixed_work", "expected": True,
                                  "actual": observed["work_confirmed"] and observed["fixed_input_unchanged"]})
            report.update(expected=expected, actual=observed, difference=delta)
            if build_status() != "current":
                report["difference"].append({"path": "$.build", "expected": "current", "actual": build_status()})
            report["status"] = "fail" if report["difference"] else "pass"
            event("check-result", scenario=options.scenario, status=report["status"], report=str(folder / "report.json"))
    except (Exception, KeyboardInterrupt) as error:
        report["status"] = "error"
        report["difference"].append({"path": "$.execution", "expected": "completed", "actual": str(error)})
    finally:
        os.environ.clear()
        os.environ.update(original_env)
        if owned:
            try:
                with contextlib.redirect_stdout(sys.stderr):
                    if report["status"] == "pass":
                        check_seed("valid")
                    else:
                        cleanup(False)
            except (RuntimeError, OSError) as error:
                report["status"] = "error"
                report["difference"].append({"path": "$.cleanup", "expected": "restored or removed scratch", "actual": str(error)})
        guard.close()
    report["evidence_path"] = str(folder / "report.json")
    save(folder / "report.json", report)
    summary = {key: report[key] for key in ("scenario", "status", "difference", "evidence_path")}
    if options.scenario == "performance" and "actual" in report:
        summary["measurements"] = {key: value for key, value in report["actual"].items() if key != "samples"}
    print(json.dumps(summary, indent=2))
    return 0 if report["status"] == "pass" else 1



def parser():
    p = argparse.ArgumentParser(description=__doc__, epilog="Examples: verify launch; verify doctor; verify drive session --mode tui; "
                                "verify drive smoke x11; verify logs; verify cleanup --dry-run; verify cleanup",
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = p.add_subparsers(dest="action", required=True)
    commands.add_parser("doctor", help="Read-only ownership, process, display/port and source/build freshness report.")
    start = commands.add_parser("launch", help="Build both Rust binaries, create an isolated seeded profile and prove usable status.")
    start.add_argument("--dry-run", action="store_true", help="Print paths/build plan without creating files or starting processes.")
    logs = commands.add_parser("logs", help="Show evidence location and the action transcript; survives cleanup.")
    logs.add_argument("--path-only", action="store_true", help="Print only the latest evidence directory.")
    clean = commands.add_parser("cleanup", help="Stop only an owned recorded PID; remove scratch state, retain all evidence.")
    clean.add_argument("--dry-run", action="store_true", help="List exact PID/path effects without changing anything.")
    drive = commands.add_parser("drive", help="Drive real CLI/TUI user input or the repository's compositor smoke runner.")
    drivers = drive.add_subparsers(dest="driver", required=True)
    config = drivers.add_parser("config", help="Edit only the disposable user's TOML, recording before/after content.")
    config.add_argument("seed", choices=SEEDS)
    config.add_argument("--zone", choices=ZONES, help="Set the Left binding to any built-in zone; valid seed only.")
    cli = drivers.add_parser("cli", help="Run one CLI command through scripts/run.sh; arguments follow --.",
                             epilog="Example: verify drive cli --expect 'last move: x=0 y=0 w=960 h=1080' -- dispatch Alt+Ctrl+Left")
    cli.add_argument("--expect", action="append", default=[], help="Required literal output; repeat for multiple observations.")
    cli.add_argument("--expect-exit", type=int, default=0, help="Expected process exit (config/dispatch errors can still exit 0).")
    cli.add_argument("arguments", nargs=argparse.REMAINDER, help="status, dispatch HOTKEY, --help, or parser-error arguments; use session for run/tui.")
    interactive = drivers.add_parser("session", help="New isolated PTY; wait for actual prompts/status, capture every input and result.",
                                    epilog="Default lifecycle: status, TUI refresh, dispatch, reload, restart, quit. "
                                    "--journey reload edits valid/invalid/empty/missing configs and verifies retention/recovery; "
                                    "--journey watcher performs those edits without explicit reload. "
                                    "Custom: --command 'dispatch Alt+Ctrl+Left' --expect 'Last action: alt+ctrl+left'.")
    interactive.add_argument("--mode", choices=("run", "tui"), default="tui")
    interactive.add_argument("--journey", choices=("lifecycle", "reload", "watcher"), default="lifecycle")
    interactive.add_argument("--command", action="append", default=[], help="Literal user line; pair each with --expect. Overrides the built-in journey.")
    interactive.add_argument("--expect", action="append", default=[], help="Literal observable result for the corresponding --command.")
    interactive.add_argument("--quit", choices=("quit", "q", "exit", "eof"), default="quit", help="Exit/cancel entry point, including terminal Ctrl-D.")
    native = drivers.add_parser("smoke", help="Run existing synthetic compositor gate, keeping assertions, logs and screenshots.",
                               epilog="gnome is seatless; kde-live is nested despite its name. Neither proves seated accelerator behavior. "
                               "gnome-live is deliberately excluded: it attaches to a shared user session.")
    native.add_argument("gate", choices=("x11", "gnome", "kde-live"))
    drivers.add_parser("tests", help="Run the repository's existing scripts/test.sh, not a parallel test framework.")
    for child in (config, cli, interactive, native, drivers.choices["tests"]):
        child.add_argument("--dry-run", action="store_true", help="Print the planned drive; do not mutate config, move windows, build, or start processes.")
    for child in (start, cli, interactive):
        child.add_argument("--backend-flag", choices=("backend", "alias"), default="backend",
                           help="Exercise --backend dry-run or the app's --dry-run alias (separate from verifier --dry-run).")
        child.add_argument("--discovery", action="store_true", help="Exercise XDG config discovery instead of explicit --config.")
    checks = commands.add_parser("check", help="Fixed-input behavioral and native end-to-end checks; JSON differences and retained proof.")
    scenarios = checks.add_subparsers(dest="scenario", required=True)
    for name, help_text in (("behaviors", "Compare all built-in/custom zones, display moves and error states through both CLI flag/config variants."),
                            ("e2e", "Reuse the native X11 smoke gate; compare observed geometry, real hotkey, reload, persistence and cancel."),
                            ("performance", "Alternate baseline/candidate startup+dispatch samples; compare confirmed work and a median regression budget.")):
        child = scenarios.add_parser(name, help=help_text)
        child.add_argument("--expected-file", default=str(EXPECTED), help="Reviewed literal result oracle; overrides are hashed into the report. Never bless actual output.")
        child.add_argument("--dry-run", action="store_true", help="Print a JSON plan without building, seeding, running or deleting anything.")
        if name == "performance":
            child.add_argument("--baseline-ref", required=True, help="Existing local git ref; resolved to a commit, archived and built separately. No checkout, fetch or ref mutation.")
            child.add_argument("--runs", type=int, default=5, help="Measured runs PER SIDE, at least 5; baseline/candidate alternate. One extra warmup each is excluded.")
            child.add_argument("--max-regression-percent", type=float, default=25, help="Fail when candidate median exceeds baseline by this percent (default 25); spread is max minus min.")
    return p


def main():
    options = parser().parse_args()
    try:
        if options.action == "check":
            return check_command(options)
        if options.action == "doctor":
            return doctor()
        if options.action == "logs":
            folders = sorted(EVIDENCE.glob("*"))
            if not folders:
                fail("No evidence yet. Run launch, then a drive command.")
            folder = artifact() if state(False) else folders[-1]
            print(folder)
            if not options.path_only:
                print((folder / "actions.jsonl").read_text())
            return 0
        if options.action == "cleanup" and options.dry_run:
            cleanup(True)
            return 0
        if getattr(options, "dry_run", False) and options.action != "cleanup":
            state(False)
            print(json.dumps({"plan": vars(options), "checkout": str(ROOT), "profile": PROFILE,
                              "scratch": str(SCRATCH), "display": f":{DISPLAY}", "tcp_ports": [],
                              "runner": str(ROOT / "scripts/run.sh"), "build": "cargo build --locked --bins",
                              "evidence_root": str(EVIDENCE)}, indent=2))
            return 0
        with lock():
            if options.action == "cleanup":
                cleanup(options.dry_run)
            elif options.action == "launch":
                launch(options)
            else:
                require_ready()
                before = snapshot()
                event("drive-start", options=vars(options), build=load(STAMP), before=before)
                try:
                    if options.driver == "config":
                        set_config(options.seed, options.zone)
                    elif options.driver == "cli":
                        args = options.arguments
                        if args and args[0] == "--":
                            args = args[1:]
                        if not args or any(a in ("run", "tui", "--config", "--backend") for a in args):
                            fail("Use drive session for run/tui, --discovery for discovery, and --backend-flag for safe backend variants. See drive cli --help.")
                        rc, text = run(app_args(options, args), "cli-" + str(time.time_ns()))
                        if rc != options.expect_exit or any(value not in text for value in options.expect):
                            fail(f"CLI result did not match exit {options.expect_exit} / {options.expect}. Inspect stdout/stderr; do not weaken the assertion.")
                    elif options.driver == "session":
                        session(options)
                    elif options.driver == "smoke":
                        smoke(options)
                    elif options.driver == "tests":
                        rc, _ = run([str(ROOT / "scripts/test.sh")], "tests-" + str(time.time_ns()), timeout=600,
                                    environment=dict(os.environ, WINDOW_ZONES_VERIFY_CHECKOUT=str(ROOT), CARGO_TARGET_DIR=str(ROOT / "target")))
                        if rc:
                            fail("Repository tests failed. Inspect the test logs and fix the reported failure.")
                    if build_status() != "current":
                        fail("Build became stale during the drive. This is not evidence; cleanup and launch again.")
                    event("drive-result", result="PASS", after=snapshot())
                    print(f"PASS {options.driver}\nEvidence: {artifact()}")
                except BaseException as error:
                    event("drive-result", result="FAIL", error=str(error), after=snapshot())
                    cleanup(False)
                    raise
        return 0
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    def interrupted(signum, frame):
        raise KeyboardInterrupt(f"signal {signum}")
    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("Interrupted. Owned child teardown ran; run cleanup to remove any remaining profile. Evidence is retained.", file=sys.stderr)
        sys.exit(130)
