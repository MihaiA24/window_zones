+        &mut self,
+        mapped: &CosmicMapped,
+        frame: Rectangle<i32, Global>,
+    ) -> Option<Serial> {
+        let output = self.space.outputs().next().unwrap().clone();
+        self.animations.remove(mapped);
+        mapped.moved_since_mapped.store(true, Ordering::SeqCst);
